{
    "name": "laminas-api-tools/api-tools-mvc-auth",
    "description": "Laminas Module providing Authentication and Authorization events and infrastructure",
    "license": "BSD-3-Clause",
    "keywords": [
        "laminas",
        "api-tools",
        "module"
    ],
    "homepage": "https://api-tools.getlaminas.org",
    "support": {
        "docs": "https://api-tools.getlaminas.org/documentation",
        "issues": "https://github.com/laminas-api-tools/api-tools-mvc-auth/issues",
        "source": "https://github.com/laminas-api-tools/api-tools-mvc-auth",
        "rss": "https://github.com/laminas-api-tools/api-tools-mvc-auth/releases.atom",
        "chat": "https://laminas.dev/chat",
        "forum": "https://discourse.laminas.dev"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "platform": {
            "php": "8.2.99"
        }
    },
    "extra": {
        "laminas": {
            "module": "Laminas\\ApiTools\\MvcAuth"
        }
    },
    "require": {
        "laminas/laminas-authentication": "^2.19",
        "laminas/laminas-eventmanager": "^3.15",
        "laminas/laminas-http": "^2.23 || ^3.0",
        "laminas/laminas-modulemanager": "^2.19",
        "laminas/laminas-mvc": "^3.8",
        "laminas/laminas-permissions-acl": "^2.18",
        "laminas/laminas-permissions-rbac": "^3.8",
        "laminas/laminas-router": "^3.16",
        "laminas/laminas-servicemanager": "^3.24",
        "laminas/laminas-stdlib": "^3.21",
        "php": "~8.2.0 || ~8.3.0 || ~8.4.0 || ~8.5.0",
        "psr/container": "^1.1 || ^2.0"
    },
    "require-dev": {
        "bshaffer/oauth2-server-php": "^1.14.1",
        "laminas-api-tools/api-tools-oauth2": "^1.11",
        "laminas/laminas-coding-standard": "^3.1",
        "laminas/laminas-session": "^2.26",
        "phpspec/prophecy-phpunit": "^2.3",
        "phpunit/phpunit": "^11.0 || ^12.0 || ^13.0",
        "psalm/plugin-phpunit": "^0.19",
        "vimeo/psalm": "^6.14"
    },
    "autoload": {
        "psr-4": {
            "Laminas\\ApiTools\\MvcAuth\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "LaminasTest\\ApiTools\\MvcAuth\\": "test/"
        }
    },
    "scripts": {
        "check": [
            "@cs-check",
            "@test"
        ],
        "cs-check": "phpcs",
        "cs-fix": "phpcbf",
        "static-analysis": "psalm --shepherd --stats",
        "test": "phpunit --colors=always",
        "test-coverage": "phpunit --colors=always --coverage-clover clover.xml"
    },
    "replace": {
        "zfcampus/zf-mvc-auth": "^1.5.1"
    },
    "repositories": [
        {
            "type": "git",
            "url": "https://github.com/datasage/api-tools-api-problem"
        },
        {
            "type": "git",
            "url": "https://github.com/datasage/api-tools-content-negotiation"
        },
        {
            "type": "git",
            "url": "https://github.com/datasage/api-tools-oauth2"
        },
        {
            "type": "git",
            "url": "https://github.com/datasage/laminas-mvc"
        }
    ],
    "suggest": {
        "bshaffer/oauth2-server-php": "^1.14.1, required by the OAuth2 authentication adapter",
        "laminas-api-tools/api-tools-oauth2": "^1.11, to use the OAuth2 authentication adapter"
    }
}
